            "state": "translated",
            "value": "No Notes"
          }
        }
      }
    },
    "메모 작성 시 위치가 자동으로 기록됩니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location is automatically recorded when you write a note."
          }
        }
      }
    },
    "메모 편집 화면의 ✦ 버튼을 눌러 AI 도구를 사용하세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the ✦ button on the note editor to use AI tools."
          }
        }
      }
    },
